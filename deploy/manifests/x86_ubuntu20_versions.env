# Pinned commercial deployment baseline for x86_64 Ubuntu 20.04.
DORAEMON_TARGET_ARCH=x86_64
DORAEMON_TARGET_UBUNTU=20.04

# Kitware's official prebuilt x86_64 archive. Ubuntu 20.04's apt CMake 3.16
# must not be used for the commercial dependency build.
CMAKE_VERSION=3.20.6
CMAKE_LINUX_X86_64_URL=https://github.com/Kitware/CMake/releases/download/v3.20.6/cmake-3.20.6-linux-x86_64.tar.gz
CMAKE_LINUX_X86_64_SHA256=458777097903b0f35a0452266b923f0a2f5b62fe331e636e2dcc4b636b768e36
# Canonical digest of the extracted Kitware tree. The digest normalizes names,
# timestamps and ownership but preserves file contents, modes and symlinks.
CMAKE_INSTALLED_TREE_SHA256=d59116f0550ef490aeffa2865032f08fac5a14f1fd97c0146aa3cdf85a00dc90

# Immutable commercial release identities. The backend commit is established by
# the annotated deployment tag; the repository must be a clean shallow clone.
DORAEMON_BACKEND_GIT_URL=https://github.com/abc467/Doraemon.git
DORAEMON_BACKEND_DEPLOYMENT_TAG=deployment-2026-07-24-x86-ubuntu20-v9
DORAEMON_FRONTEND_DEPLOYMENT_TAG=deployment-2026-07-22-frontend-v3
DORAEMON_FRONTEND_VERSION=0.1.0-rc.11

# Ubuntu 20.04's default GCC 9 cannot build the pinned OR-Tools source. Keep
# both the apt package major and the expected upstream compiler version here.
GCC_TOOLCHAIN_MAJOR=10
GCC_TOOLCHAIN_VERSION=10.5.0

# Coverage planning uses Shapely in production. Use Ubuntu focal's signed,
# Python 3.8/system-GEOS-integrated package instead of an unreviewed pip wheel
# or a host-specific source build. The package metadata digest is pinned too.
SHAPELY_APT_PACKAGE=python3-shapely
SHAPELY_APT_VERSION=1.7.0-1build1
SHAPELY_APT_ARCH=amd64
SHAPELY_APT_DEB_SHA256=230c303ce98fb8fdb4906ec5ce3c32b6a662af032c767682b4c3bdcd2dfb2686
SHAPELY_PYTHON_VERSION=1.7.0

# Commercial ROS1 apt baseline. The signing key remains the official ROS key;
# only package transport is delegated to the approved USTC HTTPS mirror.
ROS1_APT_REPOSITORY_URL=https://mirrors.ustc.edu.cn/ros/ubuntu
ROS1_APT_SUITE=focal
ROS1_APT_COMPONENT=main
ROS1_APT_KEY_URL=https://raw.githubusercontent.com/ros/rosdistro/master/ros.key
ROS1_APT_KEY_SHA256=4a91c49af0d6f0016108b93698782b596c27ccd836937e18e0e36c3347dc602f
ROS1_APT_KEY_FINGERPRINT=C1CF6E31E6BADE8868B172B4F42ED6FBAB17C654

ABSEIL_VERSION=20211102.0
ABSEIL_COMMIT=215105818dfde3174fe799600bb0f3cae233d0bf

ORTOOLS_VERSION=9.9
ORTOOLS_COMMIT=3c5c99c278ef3d0ac85cdbd4f008f8c0fd2f3f94

FIELDS2COVER_VERSION=2.0.0
FIELDS2COVER_COMMIT=3613525c241538fa9fd9df3e1209ae8184627958

# This compatibility snapshot matches the FLIRT ABI used by Doraemon Cartographer.
FLIRT_VERSION=doraemon-20260319
FLIRT_UPSTREAM_COMMIT=56bf33effbdae8280be4039309523203b8e4257c

# Local source overlay. The upstream binding fix is applied as its exact
# one-line hunk on top of the pinned 0.11.17 package.
ROSBRIDGE_SERVER_VERSION=0.11.17
ROSBRIDGE_SERVER_COMMIT=55a6bdb20842a3f7f0e17931b7856c3d8700f9fb
ROSBRIDGE_BINDING_FIX_COMMIT=f6a829abaeca9763c5d00ba5a232407e789bdbfa
ROSBRIDGE_WEBSOCKET_BASE_SHA256=c3f3d27b1f32f0fe80aaf427178b384c2ad361857c9c6f8a45d0fdbdcd6f8275
ROSBRIDGE_WEBSOCKET_PATCHED_SHA256=f5b31634e8a759ee54db9b36bf1a64b3ee96ab4bfbf5f1d8e8ade21c5c707021

NODE_VERSION=22.23.1
NODE_LINUX_X64_SHA256=9749e988f437343b7fa832c69ded82a312e41a03116d766797ac14f6f9eee578
