<launch>
  <!--
    Real-robot bringup (minimal):
      - hardware TCP bridges
      - docking controller (fine docking action)
      - coverage task+executor system, with dock_supply enabled

    Usage:
      roslaunch robot_hw_bridge bringup_real_robot.launch
  -->

  <arg name="start_navigation" default="true"/>
  <arg name="plan_db_path" default="/data/coverage/planning.db"/>
  <arg name="ops_db_path" default="/data/coverage/operations.db"/>
  <arg name="maps_root" default="/data/maps"/>
  <arg name="external_maps_root" default="/data/maps/imports"/>
  <arg name="robot_id" default="local_robot"/>
  <arg name="map_name" default=""/>
  <arg name="cartographer_mode" default="localization"/>
  <arg name="cartographer_runtime_ns" default="/cartographer/runtime"/>
  <arg name="cartographer_config_root" default=""/>
  <arg name="start_base_runtime" default="true"/>
  <arg name="start_lidar" default="true"/>
  <arg name="lidar_ntp_ip" default="192.168.127.88"/>
  <arg name="lidar_ntp_port" default="5678"/>
  <arg name="lidar_ntp_enable" default="-1"/>
  <arg name="start_imu" default="true"/>
  <arg name="imu_port" default="/dev/imu"/>
  <arg name="imu_baud" default="115200"/>
  <arg name="imu_slave_address" default="1"/>
  <arg name="start_odometry_runtime" default="true"/>
  <arg name="odom_serial_device" default="/dev/wheel_odom"/>
  <arg name="odom_serial_baudrate" default="115200"/>
  <arg name="odom_protocol_mode" default="framed_434c"/>
  <arg name="odom_use_device_timestamp" default="false"/>
  <arg name="odom_publish_raw_tf" default="false"/>
  <arg name="odom_wheel_separation" default="0.46"/>
  <arg name="odom_wheel_diameter" default="0.165"/>
  <arg name="odom_gear_ratio" default="9.0"/>
  <arg name="odom_encoder_ppr" default="10000.0"/>
  <arg name="odom_left_encoder_sign" default="1.0"/>
  <arg name="odom_right_encoder_sign" default="-1.0"/>
  <arg name="odom_left_wheel_scale" default="1.0"/>
  <arg name="odom_right_wheel_scale" default="1.0"/>
  <arg name="odom_angular_velocity_sign" default="-1.0"/>
  <arg name="robot_description_path" default="$(find cleanrobot_description)/urdf/a26022_clean_robot.urdf"/>
  <arg name="publish_base_footprint_to_base_link" default="false"/>
  <arg name="base_footprint_to_base_link_z" default="0.0"/>
  <arg name="publish_base_footprint_to_gyro_link" default="false"/>
  <arg name="start_planner_server" default="true"/>
  <arg name="enable_rect_zone_planner" default="true"/>
  <arg name="enable_depth_obstacle_tracking" default="true"/>
  <arg name="start_depth_camera_runtime" default="true"/>
  <arg name="publish_robot_tf_for_depth_cameras" default="false"/>
  <arg name="enable_depth_left_cam" default="true"/>
  <arg name="enable_depth_right_cam" default="true"/>
  <arg name="enable_depth_up_cam" default="true"/>
  <arg name="depth_left_points_topic" default="/gemini_cf/depth/points"/>
  <arg name="depth_right_points_topic" default="/gemini_nj/depth/points"/>
  <arg name="depth_up_points_topic" default="/gemini_front/depth/points"/>
  <arg name="depth_left_obstacle_topic" default="obstacle_2d"/>
  <arg name="depth_right_obstacle_topic" default="obstacle_2d"/>
  <arg name="depth_up_obstacle_topic" default="obstacle_2d"/>
  <arg name="camera1_bind_by_usb_port" default="false"/>
  <arg name="camera2_bind_by_usb_port" default="false"/>
  <arg name="camera3_bind_by_usb_port" default="false"/>
  <arg name="mechanical_connect_enable" default="false"/>
  <arg name="charge_voltage_confirm_enable" default="false"/>
  <arg name="target_soc" default="0.95"/>
  <arg name="dock_target_dist" default="0.780"/>
  <arg name="dock_xy_tolerance" default="0.005"/>
  <arg name="dock_yaw_tolerance" default="0.04"/>
  <arg name="dock_pose_score_thresh" default="0.00012"/>
  <arg name="dock_pose_score_topic" default="/dock_pose_score"/>
  <arg name="skip_precise_docking_if_station_in_place" default="false"/>
  <arg name="direct_charge_after_precise_docking" default="true"/>
  <arg name="dock_supply_enable_drain" default="true"/>
  <arg name="dock_supply_enable_refill" default="false"/>
  <arg name="dock_supply_drain_timeout_s" default="600.0"/>
  <arg name="dock_supply_drain_settle_s" default="30.0"/>
  <arg name="dock_supply_combined_status_wait_s" default="5.0"/>
  <arg name="dock_supply_combined_status_stale_timeout_s" default="3.0"/>
  <arg name="task_auto_charge_enable" default="true"/>
  <arg name="executor_auto_charge_enable" default="false"/>
  <arg name="default_return_to_dock_on_finish" default="false"/>
  <arg name="low_soc" default="0.15"/>
  <arg name="resume_soc" default="0.95"/>
  <arg name="rearm_soc" default="0.95"/>
  <arg name="dock_calibration_storage_path" default="/data/coverage/dock_calibration.yaml"/>
  <arg name="auto_charge_monitor_enable" default="true"/>
  <arg name="auto_charge_monitor_reset_on_start" default="false"/>
  <arg name="auto_charge_monitor_count_auto_only" default="true"/>
  <arg name="auto_charge_monitor_recovery_enable" default="true"/>
  <arg name="auto_charge_monitor_recovery_timeout_s" default="300.0"/>
  <arg name="auto_charge_monitor_recovery_min_soc_delta" default="0.001"/>
  <arg name="auto_charge_monitor_recovery_max_attempts" default="1"/>
  <arg name="auto_charge_monitor_recovery_back_distance_m" default="0.20"/>
  <arg name="auto_charge_monitor_recovery_forward_distance_m" default="0.205"/>
  <arg name="auto_charge_monitor_recovery_speed_mps" default="0.03"/>
  <arg name="auto_charge_monitor_recovery_toggle_charge" default="false"/>
  <arg name="enable_mcore_bridge" default="false"/>
  <arg name="enable_mcore_velocity_sender" default="true"/>
  <arg name="mcore_transport" default="tcp"/>
  <arg name="mcore_serial_device" default="/dev/mcore"/>
  <arg name="mcore_serial_baudrate" default="115200"/>
  <arg name="mcore_tcp_host" default="192.168.127.10"/>
  <arg name="mcore_tcp_port" default="8080"/>
  <arg name="mcore_enable_cmd_vel" default="false"/>
  <arg name="mcore_server_ip" default="192.168.127.10"/>
  <arg name="mcore_server_port" default="5001"/>
  <arg name="mcore_cmd_vel_topic" default="/cmd_vel"/>
  <arg name="mcore_safety_status_bits_topic" default="/mcore_velocity_sender/safety_status_bits"/>
  <arg name="mcore_telemetry_heartbeat_topic" default="/mcore_velocity_sender/telemetry_heartbeat"/>
  <arg name="actuator_debug_telemetry_stale_s" default="2.0"/>
  <arg name="actuator_debug_safety_status_stale_s" default="2.0"/>
  <arg name="actuator_debug_require_safety_status" default="true"/>
  <arg name="actuator_debug_unreadable_estop_ack_s" default="15.0"/>
  <arg name="actuator_debug_post_off_status_wait_s" default="3.0"/>
  <arg name="mcore_send_rate_hz" default="10.0"/>
  <arg name="mcore_send_immediately" default="true"/>
  <arg name="mcore_repeat_last_cmd_vel" default="false"/>
  <arg name="mcore_linear_velocity_scale" default="1000.0"/>
  <arg name="mcore_angular_velocity_scale" default="1000.0"/>
  <arg name="mcore_linear_velocity_sign" default="1.0"/>
  <arg name="mcore_angular_velocity_sign" default="1.0"/>
  <arg name="mcore_max_abs_linear_velocity" default="0.0"/>
  <arg name="mcore_max_abs_angular_velocity" default="0.0"/>
  <arg name="enable_station_bridge" default="true"/>
  <arg name="station_server_ip" default="192.168.127.12"/>
  <arg name="station_server_port" default="5007"/>
  <arg name="station_tx_header" default="50 43"/>
  <arg name="station_heartbeat_enable" default="false"/>
  <arg name="enable_dock_supply_manager" default="true"/>
  <arg name="enable_docking_stack" default="true"/>
  <arg name="restart_localization_app_service_name" default="/cartographer/runtime/app/restart_localization"/>
  <arg name="restart_localization_app_contract_param_ns" default="/cartographer/runtime/contracts/app/restart_localization"/>
  <arg name="odometry_health_imu_topic" default="/imu"/>
  <arg name="odometry_health_ekf_node_name" default="/wheel_speed_odom_ekf"/>

  <group if="$(arg start_base_runtime)">
    <include file="$(find cleanrobot)/launch/cleanrobot_base.launch">
      <arg name="start_robot_state_publisher" value="true"/>
      <arg name="robot_description_path" value="$(arg robot_description_path)"/>
      <arg name="start_lidar" value="$(arg start_lidar)"/>
      <arg name="lidar_ntp_ip" value="$(arg lidar_ntp_ip)"/>
      <arg name="lidar_ntp_port" value="$(arg lidar_ntp_port)"/>
      <arg name="lidar_ntp_enable" value="$(arg lidar_ntp_enable)"/>
      <arg name="start_imu" value="$(arg start_imu)"/>
      <arg name="imu_port" value="$(arg imu_port)"/>
      <arg name="imu_baud" value="$(arg imu_baud)"/>
      <arg name="imu_slave_address" value="$(arg imu_slave_address)"/>
      <arg name="start_ahrs" value="false"/>
      <arg name="start_depth_cameras" value="false"/>
    </include>
  </group>

  <!-- start TCP bridges + supply manager -->
  <include file="$(find robot_hw_bridge)/launch/hardware_bridges.launch">
    <arg name="enable_mcore_bridge" value="$(arg enable_mcore_bridge)"/>
    <arg name="mcore_enable_cmd_vel" value="$(arg mcore_enable_cmd_vel)"/>
    <arg name="mcore_server_ip" value="$(arg mcore_server_ip)"/>
    <arg name="mcore_server_port" value="$(arg mcore_server_port)"/>
    <arg name="mcore_cmd_vel_topic" value="$(arg mcore_cmd_vel_topic)"/>
    <arg name="mcore_linear_velocity_scale" value="$(arg mcore_linear_velocity_scale)"/>
    <arg name="mcore_angular_velocity_scale" value="$(arg mcore_angular_velocity_scale)"/>
    <arg name="mcore_linear_velocity_sign" value="$(arg mcore_linear_velocity_sign)"/>
    <arg name="mcore_angular_velocity_sign" value="$(arg mcore_angular_velocity_sign)"/>
    <arg name="mcore_max_abs_linear_velocity" value="$(arg mcore_max_abs_linear_velocity)"/>
    <arg name="mcore_max_abs_angular_velocity" value="$(arg mcore_max_abs_angular_velocity)"/>
    <arg name="enable_station_bridge" value="$(arg enable_station_bridge)"/>
    <arg name="station_server_ip" value="$(arg station_server_ip)"/>
    <arg name="station_server_port" value="$(arg station_server_port)"/>
    <arg name="station_tx_header" value="$(arg station_tx_header)"/>
    <arg name="station_heartbeat_enable" value="$(arg station_heartbeat_enable)"/>
    <arg name="enable_dock_supply_manager" value="$(arg enable_dock_supply_manager)"/>
    <arg name="enable_docking_stack" value="$(arg enable_docking_stack)"/>
    <arg name="mechanical_connect_enable" value="$(arg mechanical_connect_enable)"/>
    <arg name="skip_precise_docking_if_station_in_place" value="$(arg skip_precise_docking_if_station_in_place)"/>
    <arg name="direct_charge_after_precise_docking" value="$(arg direct_charge_after_precise_docking)"/>
    <arg name="dock_supply_enable_drain" value="$(arg dock_supply_enable_drain)"/>
    <arg name="dock_supply_enable_refill" value="$(arg dock_supply_enable_refill)"/>
    <arg name="dock_supply_drain_timeout_s" value="$(arg dock_supply_drain_timeout_s)"/>
    <arg name="dock_supply_drain_settle_s" value="$(arg dock_supply_drain_settle_s)"/>
    <arg name="dock_supply_combined_status_wait_s" value="$(arg dock_supply_combined_status_wait_s)"/>
    <arg name="dock_supply_combined_status_stale_timeout_s" value="$(arg dock_supply_combined_status_stale_timeout_s)"/>
    <arg name="charge_voltage_confirm_enable" value="$(arg charge_voltage_confirm_enable)"/>
    <arg name="target_soc" value="$(arg target_soc)"/>
    <arg name="dock_target_dist" value="$(arg dock_target_dist)"/>
    <arg name="dock_xy_tolerance" value="$(arg dock_xy_tolerance)"/>
    <arg name="dock_yaw_tolerance" value="$(arg dock_yaw_tolerance)"/>
    <arg name="dock_pose_score_thresh" value="$(arg dock_pose_score_thresh)"/>
    <arg name="dock_pose_score_topic" value="$(arg dock_pose_score_topic)"/>
  </include>

  <group if="$(arg enable_mcore_velocity_sender)">
    <include file="$(find mcore_chassis_bridge)/launch/mcore_velocity_sender.launch">
      <arg name="transport" value="$(arg mcore_transport)"/>
      <arg name="serial_device" value="$(arg mcore_serial_device)"/>
      <arg name="serial_baudrate" value="$(arg mcore_serial_baudrate)"/>
      <arg name="tcp_host" value="$(arg mcore_tcp_host)"/>
      <arg name="tcp_port" value="$(arg mcore_tcp_port)"/>
      <arg name="cmd_vel_topic" value="$(arg mcore_cmd_vel_topic)"/>
      <arg name="safety_status_bits_topic" value="$(arg mcore_safety_status_bits_topic)"/>
      <arg name="telemetry_heartbeat_topic" value="$(arg mcore_telemetry_heartbeat_topic)"/>
      <arg name="send_rate_hz" value="$(arg mcore_send_rate_hz)"/>
      <arg name="send_immediately" value="$(arg mcore_send_immediately)"/>
      <arg name="repeat_last_cmd_vel" value="$(arg mcore_repeat_last_cmd_vel)"/>
      <arg name="linear_velocity_scale" value="$(arg mcore_linear_velocity_scale)"/>
      <arg name="angular_velocity_scale" value="$(arg mcore_angular_velocity_scale)"/>
      <arg name="linear_velocity_sign" value="$(arg mcore_linear_velocity_sign)"/>
      <arg name="angular_velocity_sign" value="$(arg mcore_angular_velocity_sign)"/>
      <arg name="max_abs_linear_velocity" value="$(arg mcore_max_abs_linear_velocity)"/>
      <arg name="max_abs_angular_velocity" value="$(arg mcore_max_abs_angular_velocity)"/>
      <arg name="enable_tx_log" value="false"/>
      <arg name="enable_rx_log" value="true"/>
    </include>
  </group>

  <group if="$(arg start_navigation)">
    <group if="$(arg start_odometry_runtime)">
      <include file="$(find wheel_speed_odom_bridge)/launch/wheel_speed_odom.launch">
        <arg name="serial_device" value="$(arg odom_serial_device)"/>
        <arg name="serial_baudrate" value="$(arg odom_serial_baudrate)"/>
        <arg name="protocol_mode" value="$(arg odom_protocol_mode)"/>
        <arg name="use_device_timestamp" value="$(arg odom_use_device_timestamp)"/>
        <arg name="publish_raw_odom_tf" value="$(arg odom_publish_raw_tf)"/>
        <arg name="imu_topic" value="/imu"/>
        <arg name="wheel_separation" value="$(arg odom_wheel_separation)"/>
        <arg name="wheel_diameter" value="$(arg odom_wheel_diameter)"/>
        <arg name="gear_ratio" value="$(arg odom_gear_ratio)"/>
        <arg name="encoder_pulses_per_motor_revolution" value="$(arg odom_encoder_ppr)"/>
        <arg name="left_encoder_sign" value="$(arg odom_left_encoder_sign)"/>
        <arg name="right_encoder_sign" value="$(arg odom_right_encoder_sign)"/>
        <arg name="left_wheel_scale" value="$(arg odom_left_wheel_scale)"/>
        <arg name="right_wheel_scale" value="$(arg odom_right_wheel_scale)"/>
        <arg name="angular_velocity_sign" value="$(arg odom_angular_velocity_sign)"/>
      </include>
    </group>

    <group if="$(arg enable_depth_obstacle_tracking)">
      <group if="$(arg start_depth_camera_runtime)">
        <include file="$(find cleanrobot)/launch/depth_obstacle_runtime.launch">
          <arg name="start_robot_state_publisher" value="$(arg publish_robot_tf_for_depth_cameras)"/>
          <arg name="robot_description_path" value="$(arg robot_description_path)"/>
          <arg name="publish_base_footprint_to_base_link" value="$(arg publish_base_footprint_to_base_link)"/>
          <arg name="base_footprint_to_base_link_z" value="$(arg base_footprint_to_base_link_z)"/>
          <arg name="publish_base_footprint_to_gyro_link" value="$(arg publish_base_footprint_to_gyro_link)"/>
          <arg name="start_depth_cameras" value="true"/>
          <arg name="start_depth_obstacle_tracking" value="false"/>
          <arg name="camera1_bind_by_usb_port" value="$(arg camera1_bind_by_usb_port)"/>
          <arg name="camera2_bind_by_usb_port" value="$(arg camera2_bind_by_usb_port)"/>
          <arg name="camera3_bind_by_usb_port" value="$(arg camera3_bind_by_usb_port)"/>
        </include>
      </group>
    </group>

    <include file="$(find cleanrobot)/launch/mbf_nav.launch">
      <arg name="plan_db_path" value="$(arg plan_db_path)"/>
      <arg name="ops_db_path" value="$(arg ops_db_path)"/>
      <arg name="robot_id" value="$(arg robot_id)"/>
      <arg name="map_name" value="$(arg map_name)"/>
      <arg name="external_maps_root" value="$(arg external_maps_root)"/>
      <arg name="enable_depth_obstacle_tracking" value="$(arg enable_depth_obstacle_tracking)"/>
      <arg name="enable_depth_left_cam" value="$(arg enable_depth_left_cam)"/>
      <arg name="enable_depth_right_cam" value="$(arg enable_depth_right_cam)"/>
      <arg name="enable_depth_up_cam" value="$(arg enable_depth_up_cam)"/>
      <arg name="depth_left_points_topic" value="$(arg depth_left_points_topic)"/>
      <arg name="depth_right_points_topic" value="$(arg depth_right_points_topic)"/>
      <arg name="depth_up_points_topic" value="$(arg depth_up_points_topic)"/>
      <arg name="depth_left_obstacle_topic" value="$(arg depth_left_obstacle_topic)"/>
      <arg name="depth_right_obstacle_topic" value="$(arg depth_right_obstacle_topic)"/>
      <arg name="depth_up_obstacle_topic" value="$(arg depth_up_obstacle_topic)"/>
    </include>

    <!-- Official runtime owner chain:
         planner_server.launch -> slam_runtime_manager/slam_api_service.
         Do not start cleanrobot/cartographer_supervisor in formal bringup. -->
    <group if="$(arg start_planner_server)">
      <node pkg="coverage_planner" type="localization_lifecycle_manager_node.py" name="localization_lifecycle_manager" output="screen" respawn="true" respawn_delay="2.0">
        <param name="plan_db_path" value="$(arg plan_db_path)"/>
        <param name="ops_db_path" value="$(arg ops_db_path)"/>
        <param name="robot_id" value="$(arg robot_id)"/>
        <param name="runtime_ns" value="$(arg cartographer_runtime_ns)"/>
        <param name="app_service_name" value="$(arg restart_localization_app_service_name)"/>
        <param name="app_contract_param_ns" value="$(arg restart_localization_app_contract_param_ns)"/>
        <param name="map_topic" value="/map"/>
        <param name="tracked_pose_topic" value="/tracked_pose"/>
      </node>

      <include file="$(find coverage_planner)/launch/planner_server.launch">
        <arg name="plan_db_path" value="$(arg plan_db_path)"/>
        <arg name="ops_db_path" value="$(arg ops_db_path)"/>
        <arg name="maps_root" value="$(arg maps_root)"/>
        <arg name="robot_id" value="$(arg robot_id)"/>
        <arg name="map_topic" value="/map"/>
        <arg name="enable_rect_zone_planner" value="$(arg enable_rect_zone_planner)"/>
        <arg name="enable_odometry_health" value="false"/>
      </include>
    </group>
  </group>

  <!-- task+executor system (task manager owns auto charge) -->
  <include file="$(find coverage_task_manager)/launch/task_system.launch">
    <arg name="task_auto_charge_enable" value="$(arg task_auto_charge_enable)"/>
    <arg name="executor_auto_charge_enable" value="$(arg executor_auto_charge_enable)"/>
    <arg name="default_return_to_dock_on_finish" value="$(arg default_return_to_dock_on_finish)"/>
    <arg name="dock_supply_enable" value="true"/>
    <arg name="low_soc" value="$(arg low_soc)"/>
    <arg name="resume_soc" value="$(arg resume_soc)"/>
    <arg name="rearm_soc" value="$(arg rearm_soc)"/>
    <arg name="plan_db_path" value="$(arg plan_db_path)"/>
    <arg name="ops_db_path" value="$(arg ops_db_path)"/>
    <arg name="maps_root" value="$(arg maps_root)"/>
    <arg name="robot_id" value="$(arg robot_id)"/>
    <arg name="mcore_safety_status_bits_topic" value="$(arg mcore_safety_status_bits_topic)"/>
    <arg name="mcore_telemetry_heartbeat_topic" value="$(arg mcore_telemetry_heartbeat_topic)"/>
    <arg name="actuator_debug_telemetry_stale_s" value="$(arg actuator_debug_telemetry_stale_s)"/>
    <arg name="actuator_debug_safety_status_stale_s" value="$(arg actuator_debug_safety_status_stale_s)"/>
    <arg name="actuator_debug_require_safety_status" value="$(arg actuator_debug_require_safety_status)"/>
    <arg name="actuator_debug_unreadable_estop_ack_s" value="$(arg actuator_debug_unreadable_estop_ack_s)"/>
    <arg name="actuator_debug_post_off_status_wait_s" value="$(arg actuator_debug_post_off_status_wait_s)"/>
    <arg name="start_odometry_health" value="true"/>
    <arg name="odometry_health_imu_topic" value="$(arg odometry_health_imu_topic)"/>
    <arg name="odometry_health_ekf_node_name" value="$(arg odometry_health_ekf_node_name)"/>
    <arg name="start_localization_lifecycle_manager" value="false"/>
    <arg name="dock_calibration_score_topic" value="$(arg dock_pose_score_topic)"/>
    <arg name="dock_calibration_storage_path" value="$(arg dock_calibration_storage_path)"/>
    <arg name="dock_calibration_score_threshold" value="$(arg dock_pose_score_thresh)"/>
    <arg name="dock_calibration_target_dist" value="$(arg dock_target_dist)"/>
    <arg name="dock_calibration_xy_tolerance" value="$(arg dock_xy_tolerance)"/>
    <arg name="auto_charge_monitor_enable" value="$(arg auto_charge_monitor_enable)"/>
    <arg name="auto_charge_monitor_reset_on_start" value="$(arg auto_charge_monitor_reset_on_start)"/>
    <arg name="auto_charge_monitor_count_auto_only" value="$(arg auto_charge_monitor_count_auto_only)"/>
    <arg name="auto_charge_monitor_recovery_enable" value="$(arg auto_charge_monitor_recovery_enable)"/>
    <arg name="auto_charge_monitor_recovery_timeout_s" value="$(arg auto_charge_monitor_recovery_timeout_s)"/>
    <arg name="auto_charge_monitor_recovery_min_soc_delta" value="$(arg auto_charge_monitor_recovery_min_soc_delta)"/>
    <arg name="auto_charge_monitor_recovery_max_attempts" value="$(arg auto_charge_monitor_recovery_max_attempts)"/>
    <arg name="auto_charge_monitor_recovery_back_distance_m" value="$(arg auto_charge_monitor_recovery_back_distance_m)"/>
    <arg name="auto_charge_monitor_recovery_forward_distance_m" value="$(arg auto_charge_monitor_recovery_forward_distance_m)"/>
    <arg name="auto_charge_monitor_recovery_speed_mps" value="$(arg auto_charge_monitor_recovery_speed_mps)"/>
    <arg name="auto_charge_monitor_recovery_toggle_charge" value="$(arg auto_charge_monitor_recovery_toggle_charge)"/>
    <arg name="run_map_migration" value="false"/>
  </include>

</launch>
