uint8 GET=0
uint8 SAVE_STAGE1=1
uint8 SAVE_STAGE2=2
uint8 SET_STAGE1=3
uint8 SET_STAGE2=4
uint8 RELOAD=5
uint8 SET_DOCK_PARAMS=6

uint8 operation
string robot_id

# SET_STAGE1/SET_STAGE2 use these fields. SAVE_* ignores them and records the
# current tracked map pose.
float64 x
float64 y
float64 yaw

# Optional strict gate for SAVE_STAGE2. The frontend can leave this false when
# an operator is allowed to judge the dock score manually.
bool require_stage2_quality

# SET_DOCK_PARAMS updates precise docking stop/success parameters.
# Larger values stop farther from the charging pile; smaller values move closer.
float64 dock_target_dist
float64 dock_xy_tolerance
---
bool success
string message
string error_code
uint8 operation
DockCalibrationState state
