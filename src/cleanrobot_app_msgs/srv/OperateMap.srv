uint8 get = 0
uint8 add = 1
uint8 modify = 2
uint8 Delete = 3
uint8 getAll = 4
uint8 hardDelete = 5
uint8 cleanupDisabled = 6
int8 ENABLE_KEEP = 0
int8 ENABLE_DISABLE = 1
int8 ENABLE_ENABLE = 2

uint8 operation # get; add; modify; Delete(soft-disable); getAll; hardDelete; cleanupDisabled
string map_name
PgmData map
bool set_active
int8 enabled_state # 0: 保持不变 1: 禁用 2: 启用
bool dry_run # hardDelete / cleanupDisabled 默认应先 dry-run；真正删除需 dry_run=false
bool force # 预留：当前仍不允许删除 active/runtime/pending/有引用 revision
bool cascade # hardDelete / cleanupDisabled: true 表示确认后级联删除下属业务资产；已结束运行按身份快照归档，活动运行仍阻止删除
uint32 min_age_days # cleanupDisabled: 只清理停用后超过 N 天的 revision
uint64 max_reclaim_bytes # cleanupDisabled: 0 表示不限
string confirm_token # hardDelete: map_revision_id 或 DELETE:<map_revision_id>; cleanupDisabled: CLEANUP_DISABLED

---

bool success
string message
PgmData map
PgmData[] maps # getAll: one display view per map_name; get: default returns active revision when same-name head differs
bool dry_run
bool cascade
uint32 candidate_count
uint32 deleted_count
uint64 reclaimable_bytes
uint64 reclaimed_bytes
string[] deleted_paths
string[] blocked_reasons
uint32 affected_zones_count
uint32 affected_plans_count
uint32 affected_tasks_count
uint32 affected_schedules_count
uint32 affected_zone_versions_count
string confirm_token
string deleted_business_refs # JSON summary for cascade hardDelete

# add: 纳管工作空间 map 目录中的 <map_name>.pbstream 到正式资产库，可选设为当前地图
# modify: 更新资产元数据（description/enabled），可选 set_active
# Delete: 软删除/禁用 map_name，不删除磁盘文件
# hardDelete: 默认物理删除一个已停用且无业务引用的 map_revision_id；cascade=true 时级联删除该 revision 下属业务资产
# cleanupDisabled: 批量物理清理始终级联清理业务定义并归档已结束运行；需 confirm_token=CLEANUP_DISABLED 才执行
# get: 按 map_name / map_revision_id 查询；若同名 head 与 active 不同且未显式指定 revision，默认返回 active revision 视图
# getAll: 返回所有已纳管地图的展示视图，并通过 latest_head_* 字段暴露最新 head revision 信息
