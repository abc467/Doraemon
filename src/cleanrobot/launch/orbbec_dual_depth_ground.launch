<launch>
  <!-- Commercial binding mode is serial_number. Per-vehicle values are required
       through the environment or explicit launch arguments; this release must
       never silently inherit another vehicle's identities. USB-port binding is
       an explicit engineering-only mode and is never selected automatically.
       ROS topic semantics:
         gemini_cf: left depth camera
         gemini_nj: right depth camera
         gemini_front: front low-obstacle depth camera -->
  <arg name="device_num" default="3"/>
  <arg name="connection_delay" default="800"/>
  <arg name="camera2_connection_delay" default="1800"/>
  <arg name="camera3_connection_delay" default="2800"/>

  <arg name="camera1_name" default="gemini_cf"/>
  <arg name="camera2_name" default="gemini_nj"/>
  <arg name="camera3_name" default="gemini_front"/>

  <arg name="camera1_bind_by_usb_port" default="false"/>
  <arg name="camera2_bind_by_usb_port" default="false"/>
  <arg name="camera3_bind_by_usb_port" default="false"/>
  <arg name="camera1_serial_number" default="$(optenv RUNTIME_ORBBEC_CAMERA1_SERIAL_NUMBER '')"/>
  <arg name="camera2_serial_number" default="$(optenv RUNTIME_ORBBEC_CAMERA2_SERIAL_NUMBER '')"/>
  <arg name="camera3_serial_number" default="$(optenv RUNTIME_ORBBEC_CAMERA3_SERIAL_NUMBER '')"/>
  <arg name="camera1_usb_port" default="$(optenv RUNTIME_ORBBEC_CAMERA1_USB_PORT '')"/>
  <arg name="camera2_usb_port" default="$(optenv RUNTIME_ORBBEC_CAMERA2_USB_PORT '')"/>
  <arg name="camera3_usb_port" default="$(optenv RUNTIME_ORBBEC_CAMERA3_USB_PORT '')"/>

  <arg name="depth_width" default="640"/>
  <arg name="depth_height" default="400"/>
  <arg name="depth_fps" default="15"/>
  <arg name="front_depth_format" default="Y16"/>
  <arg name="front_color_width" default="640"/>
  <arg name="front_color_height" default="400"/>
  <arg name="front_color_fps" default="30"/>
  <arg name="front_color_format" default="MJPG"/>
  <arg name="sync_mode" default="standalone"/>
  <arg name="enable_frame_sync" default="false"/>
  <arg name="log_level" default="none"/>

  <group unless="$(arg camera1_bind_by_usb_port)">
    <include file="$(find orbbec_camera)/launch/gemini.launch">
      <arg name="camera_name" value="$(arg camera1_name)"/>
      <arg name="serial_number" value="$(arg camera1_serial_number)"/>
      <arg name="connection_delay" value="$(arg connection_delay)"/>
      <arg name="device_num" value="$(arg device_num)"/>
      <arg name="enable_color" value="false"/>
      <arg name="enable_ir" value="false"/>
      <arg name="enable_depth" value="true"/>
      <arg name="enable_point_cloud" value="true"/>
      <arg name="enable_colored_point_cloud" value="false"/>
      <arg name="publish_tf" value="true"/>
      <arg name="depth_width" value="$(arg depth_width)"/>
      <arg name="depth_height" value="$(arg depth_height)"/>
      <arg name="depth_fps" value="$(arg depth_fps)"/>
      <arg name="sync_mode" value="$(arg sync_mode)"/>
      <arg name="enable_frame_sync" value="$(arg enable_frame_sync)"/>
      <arg name="log_level" value="$(arg log_level)"/>
    </include>
  </group>

  <group if="$(arg camera1_bind_by_usb_port)">
    <include file="$(find orbbec_camera)/launch/gemini.launch">
      <arg name="camera_name" value="$(arg camera1_name)"/>
      <arg name="usb_port" value="$(arg camera1_usb_port)"/>
      <arg name="connection_delay" value="$(arg connection_delay)"/>
      <arg name="device_num" value="$(arg device_num)"/>
      <arg name="enable_color" value="false"/>
      <arg name="enable_ir" value="false"/>
      <arg name="enable_depth" value="true"/>
      <arg name="enable_point_cloud" value="true"/>
      <arg name="enable_colored_point_cloud" value="false"/>
      <arg name="publish_tf" value="true"/>
      <arg name="depth_width" value="$(arg depth_width)"/>
      <arg name="depth_height" value="$(arg depth_height)"/>
      <arg name="depth_fps" value="$(arg depth_fps)"/>
      <arg name="sync_mode" value="$(arg sync_mode)"/>
      <arg name="enable_frame_sync" value="$(arg enable_frame_sync)"/>
      <arg name="log_level" value="$(arg log_level)"/>
    </include>
  </group>

  <group unless="$(arg camera2_bind_by_usb_port)">
    <include file="$(find orbbec_camera)/launch/gemini.launch">
      <arg name="camera_name" value="$(arg camera2_name)"/>
      <arg name="serial_number" value="$(arg camera2_serial_number)"/>
      <arg name="connection_delay" value="$(arg camera2_connection_delay)"/>
      <arg name="device_num" value="$(arg device_num)"/>
      <arg name="enable_color" value="false"/>
      <arg name="enable_ir" value="false"/>
      <arg name="enable_depth" value="true"/>
      <arg name="enable_point_cloud" value="true"/>
      <arg name="enable_colored_point_cloud" value="false"/>
      <arg name="publish_tf" value="true"/>
      <arg name="depth_width" value="$(arg depth_width)"/>
      <arg name="depth_height" value="$(arg depth_height)"/>
      <arg name="depth_fps" value="$(arg depth_fps)"/>
      <arg name="sync_mode" value="$(arg sync_mode)"/>
      <arg name="enable_frame_sync" value="$(arg enable_frame_sync)"/>
      <arg name="log_level" value="$(arg log_level)"/>
    </include>
  </group>

  <group if="$(arg camera2_bind_by_usb_port)">
    <include file="$(find orbbec_camera)/launch/gemini.launch">
      <arg name="camera_name" value="$(arg camera2_name)"/>
      <arg name="usb_port" value="$(arg camera2_usb_port)"/>
      <arg name="connection_delay" value="$(arg camera2_connection_delay)"/>
      <arg name="device_num" value="$(arg device_num)"/>
      <arg name="enable_color" value="false"/>
      <arg name="enable_ir" value="false"/>
      <arg name="enable_depth" value="true"/>
      <arg name="enable_point_cloud" value="true"/>
      <arg name="enable_colored_point_cloud" value="false"/>
      <arg name="publish_tf" value="true"/>
      <arg name="depth_width" value="$(arg depth_width)"/>
      <arg name="depth_height" value="$(arg depth_height)"/>
      <arg name="depth_fps" value="$(arg depth_fps)"/>
      <arg name="sync_mode" value="$(arg sync_mode)"/>
      <arg name="enable_frame_sync" value="$(arg enable_frame_sync)"/>
      <arg name="log_level" value="$(arg log_level)"/>
    </include>
  </group>

  <group unless="$(arg camera3_bind_by_usb_port)">
    <include file="$(find orbbec_camera)/launch/gemini.launch">
      <arg name="camera_name" value="$(arg camera3_name)"/>
      <arg name="serial_number" value="$(arg camera3_serial_number)"/>
      <arg name="connection_delay" value="$(arg camera3_connection_delay)"/>
      <arg name="device_num" value="$(arg device_num)"/>
      <arg name="enable_color" value="true"/>
      <arg name="enable_ir" value="false"/>
      <arg name="enable_depth" value="true"/>
      <arg name="enable_point_cloud" value="true"/>
      <arg name="enable_colored_point_cloud" value="false"/>
      <arg name="publish_tf" value="true"/>
      <arg name="depth_width" value="$(arg depth_width)"/>
      <arg name="depth_height" value="$(arg depth_height)"/>
      <arg name="depth_fps" value="$(arg depth_fps)"/>
      <arg name="depth_format" value="$(arg front_depth_format)"/>
      <arg name="color_width" value="$(arg front_color_width)"/>
      <arg name="color_height" value="$(arg front_color_height)"/>
      <arg name="color_fps" value="$(arg front_color_fps)"/>
      <arg name="color_format" value="$(arg front_color_format)"/>
      <arg name="sync_mode" value="$(arg sync_mode)"/>
      <arg name="enable_frame_sync" value="$(arg enable_frame_sync)"/>
      <arg name="log_level" value="$(arg log_level)"/>
    </include>
  </group>

  <group if="$(arg camera3_bind_by_usb_port)">
    <include file="$(find orbbec_camera)/launch/gemini.launch">
      <arg name="camera_name" value="$(arg camera3_name)"/>
      <arg name="usb_port" value="$(arg camera3_usb_port)"/>
      <arg name="connection_delay" value="$(arg camera3_connection_delay)"/>
      <arg name="device_num" value="$(arg device_num)"/>
      <arg name="enable_color" value="true"/>
      <arg name="enable_ir" value="false"/>
      <arg name="enable_depth" value="true"/>
      <arg name="enable_point_cloud" value="true"/>
      <arg name="enable_colored_point_cloud" value="false"/>
      <arg name="publish_tf" value="true"/>
      <arg name="depth_width" value="$(arg depth_width)"/>
      <arg name="depth_height" value="$(arg depth_height)"/>
      <arg name="depth_fps" value="$(arg depth_fps)"/>
      <arg name="depth_format" value="$(arg front_depth_format)"/>
      <arg name="color_width" value="$(arg front_color_width)"/>
      <arg name="color_height" value="$(arg front_color_height)"/>
      <arg name="color_fps" value="$(arg front_color_fps)"/>
      <arg name="color_format" value="$(arg front_color_format)"/>
      <arg name="sync_mode" value="$(arg sync_mode)"/>
      <arg name="enable_frame_sync" value="$(arg enable_frame_sync)"/>
      <arg name="log_level" value="$(arg log_level)"/>
    </include>
  </group>
</launch>
