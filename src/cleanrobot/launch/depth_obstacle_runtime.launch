<launch>
  <arg name="start_robot_state_publisher" default="true"/>
  <arg name="robot_description_path" default="$(find cleanrobot_description)/urdf/a26022_clean_robot.urdf"/>
  <arg name="publish_base_footprint_to_base_link" default="false"/>
  <arg name="base_footprint_to_base_link_z" default="0.0"/>
  <arg name="publish_base_footprint_to_gyro_link" default="false"/>
  <arg name="start_depth_cameras" default="true"/>
  <arg name="start_depth_obstacle_tracking" default="true"/>
  <arg name="enable_depth_left_cam" default="true"/>
  <arg name="enable_depth_right_cam" default="true"/>
  <arg name="enable_depth_up_cam" default="true"/>
  <arg name="depth_left_points_topic" default="/gemini_cf/depth/points"/>
  <arg name="depth_right_points_topic" default="/gemini_nj/depth/points"/>
  <arg name="depth_up_points_topic" default="/gemini_front/depth/points"/>
  <arg name="depth_left_obstacle_topic" default="obstacle_2d"/>
  <arg name="depth_right_obstacle_topic" default="obstacle_2d"/>
  <arg name="depth_up_obstacle_topic" default="obstacle_2d"/>
  <arg name="camera1_bind_by_usb_port" default="false"/>
  <arg name="camera2_bind_by_usb_port" default="false"/>
  <arg name="camera3_bind_by_usb_port" default="false"/>

  <group if="$(arg start_robot_state_publisher)">
    <include file="$(find cleanrobot_description)/launch/robot_state_only.launch">
      <arg name="robot_description_path" value="$(arg robot_description_path)"/>
    </include>
  </group>
  <node if="$(arg publish_base_footprint_to_base_link)"
        pkg="tf"
        type="static_transform_publisher"
        name="base_footprint_to_base_link"
        args="0 0 $(arg base_footprint_to_base_link_z) 0 0 0 base_footprint base_link 100"/>
  <node if="$(arg publish_base_footprint_to_gyro_link)"
        pkg="tf"
        type="static_transform_publisher"
        name="base_footprint_to_gyro_link"
        args="0 0 0 0 0 0 base_footprint gyro_link 100"/>

  <group if="$(arg start_depth_cameras)">
    <include file="$(find cleanrobot)/launch/orbbec_dual_depth_ground.launch">
      <arg name="camera1_bind_by_usb_port" value="$(arg camera1_bind_by_usb_port)"/>
      <arg name="camera2_bind_by_usb_port" value="$(arg camera2_bind_by_usb_port)"/>
      <arg name="camera3_bind_by_usb_port" value="$(arg camera3_bind_by_usb_port)"/>
    </include>
  </group>

  <group if="$(arg start_depth_obstacle_tracking)">
    <include file="$(find ground_segmentation_tracking)/launch/duoxiangji.launch">
      <arg name="enable_cam1" value="$(arg enable_depth_left_cam)"/>
      <arg name="enable_cam2" value="$(arg enable_depth_right_cam)"/>
      <arg name="enable_cam3" value="$(arg enable_depth_up_cam)"/>
      <arg name="cam1_input_topic" value="$(arg depth_left_points_topic)"/>
      <arg name="cam2_input_topic" value="$(arg depth_right_points_topic)"/>
      <arg name="cam3_input_topic" value="$(arg depth_up_points_topic)"/>
      <arg name="cam1_output_topic" value="$(arg depth_left_obstacle_topic)"/>
      <arg name="cam2_output_topic" value="$(arg depth_right_obstacle_topic)"/>
      <arg name="cam3_output_topic" value="$(arg depth_up_obstacle_topic)"/>
    </include>
  </group>
</launch>
