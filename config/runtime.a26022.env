# Doraemon A26022 cleaning robot runtime configuration.
# The USB plugs are fixed on the current vehicle; use stable udev aliases so boot-time
# ttyUSB ordering does not matter.

DORAEMON_CHASSIS_DRIVER=mcore_tcp
CHASSIS_DRIVER=mcore_tcp
ROBOT_ID=REPLACE_WITH_VEHICLE_ASSET_ID

DORAEMON_A_BOX_IFACE=REPLACE_WITH_INTERNAL_INTERFACE
DORAEMON_A_BOX_IP=192.168.127.11
DORAEMON_MBOX_IP=192.168.127.10
DORAEMON_LIDAR_IP=192.168.127.23
DORAEMON_REQUIRE_LIDAR_PING=true
DORAEMON_REQUIRE_MBOX_PING=true

DORAEMON_IMU_DEVICE=/dev/imu
DORAEMON_ODOM_DEVICE=/dev/wheel_odom
DORAEMON_CHASSIS_DEVICE=/dev/mcore
DORAEMON_REQUIRE_IMU_DEVICE=true
DORAEMON_REQUIRE_ODOM_DEVICE=true
DORAEMON_REQUIRE_CHASSIS_DEVICE=false

# RUNTIME_ROBOT_DESCRIPTION_PATH is normally derived from the checked-out
# repository root. Set it here only when using an external robot description.
RUNTIME_START_LIDAR=true
RUNTIME_LIDAR_NTP_IP=192.168.127.88
RUNTIME_LIDAR_NTP_PORT=5678
RUNTIME_LIDAR_NTP_ENABLE=-1
RUNTIME_START_IMU=true
RUNTIME_IMU_PORT=/dev/imu
RUNTIME_IMU_BAUD=115200
RUNTIME_IMU_SLAVE_ADDRESS=1
RUNTIME_IMU_PUBLISH_RAW=true
RUNTIME_IMU_PUBLISH_DURING_CALIBRATION=true
RUNTIME_START_AHRS=false
RUNTIME_START_DEPTH_CAMERAS=true
# Commercial multi-camera startup is fail-closed on serial identity, live USB3
# speed, and consecutive depth/cloud frames. Commissioned topology values are
# diagnostic hints: moving a correctly identified USB3 camera warns but does not
# prevent startup.
RUNTIME_ORBBEC_CAMERA1_SERIAL_NUMBER=REPLACE_WITH_LEFT_CAMERA_SERIAL
RUNTIME_ORBBEC_CAMERA2_SERIAL_NUMBER=REPLACE_WITH_RIGHT_CAMERA_SERIAL
RUNTIME_ORBBEC_CAMERA3_SERIAL_NUMBER=REPLACE_WITH_FRONT_CAMERA_SERIAL
RUNTIME_ORBBEC_CAMERA1_USB_PORT=REPLACE_WITH_LEFT_CAMERA_USB3_TOPOLOGY
RUNTIME_ORBBEC_CAMERA2_USB_PORT=REPLACE_WITH_RIGHT_CAMERA_USB3_TOPOLOGY
RUNTIME_ORBBEC_CAMERA3_USB_PORT=REPLACE_WITH_FRONT_CAMERA_USB3_TOPOLOGY
RUNTIME_REQUIRE_DEPTH_CAMERA_TOPICS=true
DORAEMON_REQUIRE_DEPTH_CAMERA_IDENTITIES=true
RUNTIME_DEPTH_CAMERA_READY_SAMPLES=3
RUNTIME_DEPTH_CAMERA_READY_TIMEOUT=30
RUNTIME_DEPTH_CAMERA_INTER_START_DELAY=2
RUNTIME_DEPTH_CAMERA_WATCHDOG_ENABLE=true
RUNTIME_DEPTH_CAMERA_STALE_TIMEOUT=3.0
RUNTIME_DEPTH_CAMERA_RECOVERY_COOLDOWN=60.0
RESTART_SITE_GATEWAY_AFTER_ROSBRIDGE=false
DORAEMON_NO_ACTION_ACCEPTANCE=true
DORAEMON_ACTION_TEST_APPROVED=false
# Manual drive is absent during no-action acceptance. In an approved action run
# it behaves as a remote control: business-state gates stay off, while the live
# M-core platform status remains mandatory for physical E-stop protection.
ENABLE_MANUAL_DRIVE_SERVICE=false
MANUAL_DRIVE_REQUIRE_ROLE=false
MANUAL_DRIVE_REQUIRE_SLAM_STATE=false
MANUAL_DRIVE_REQUIRE_TASK_STATE=false
MANUAL_DRIVE_REQUIRE_ODOMETRY_STATE=false
MANUAL_DRIVE_REQUIRE_COMBINED_STATUS=true
RUNTIME_ENABLE_DEPTH_OBSTACLE_TRACKING=true
RUNTIME_ENABLE_DEPTH_LEFT_CAM=true
RUNTIME_ENABLE_DEPTH_RIGHT_CAM=true
RUNTIME_ENABLE_DEPTH_UP_CAM=true
RUNTIME_START_JOINT_STATE_PUBLISHER=false

WAIT_FOR_CORRECTED_IMU_TOPIC=
ODOMETRY_HEALTH_IMU_TOPIC=/imu
ODOMETRY_HEALTH_EKF_NODE_NAME=/wheel_speed_odom_ekf

START_WHEEL_ODOM=true
START_IMU_BIAS_CORRECTION=false
ODOM_SERIAL_DEVICE=/dev/wheel_odom
ODOM_SERIAL_BAUDRATE=115200
ODOM_PROTOCOL_MODE=framed_434c
ODOM_USE_DEVICE_TIMESTAMP=false
ODOM_PUBLISH_RAW_ODOM_TF=false
ODOM_FRAME_ID=odom
ODOM_CHILD_FRAME_ID=base_footprint
ODOM_WHEEL_SEPARATION=0.46
ODOM_WHEEL_DIAMETER=0.165
ODOM_GEAR_RATIO=9.0
ODOM_ENCODER_PPR=10000.0
ODOM_LEFT_ENCODER_SIGN=1.0
ODOM_RIGHT_ENCODER_SIGN=-1.0
ODOM_LEFT_WHEEL_SCALE=1.0
ODOM_RIGHT_WHEEL_SCALE=1.0
ODOM_ANGULAR_VELOCITY_SIGN=-1.0

# New chassis motion/cleaning command path: ROS topics -> M-core TCP using the
# same 43 4E ... DA protocol frames previously carried over serial.
START_MCORE_BRIDGE=false
START_MCORE_VELOCITY_SENDER=true
MCORE_ENABLE_CMD_VEL=false
MCORE_TRANSPORT=tcp
MCORE_TCP_HOST=192.168.127.10
MCORE_TCP_PORT=8080
MCORE_SERVER_IP=192.168.127.10
MCORE_SERVER_PORT=5001
MCORE_SERIAL_DEVICE=/dev/mcore
MCORE_SERIAL_BAUDRATE=115200
MCORE_CMD_VEL_TOPIC=/cmd_vel
MCORE_LINEAR_VELOCITY_SCALE=1000.0
MCORE_ANGULAR_VELOCITY_SCALE=1000.0
MCORE_LINEAR_VELOCITY_SIGN=1.0
MCORE_ANGULAR_VELOCITY_SIGN=1.0
# The sender keeps 0.0 as its legacy "unlimited" value. The commercial runtime
# deliberately rejects it in action-capable mode, so Stage L must set both
# finite, positive SI vehicle limits after its separate physical-safety approval.
MCORE_MAX_ABS_LINEAR_VELOCITY=0.0
MCORE_MAX_ABS_ANGULAR_VELOCITY=0.0
MCORE_ENABLE_TX_LOG=false
MCORE_ENABLE_RX_LOG=true

# This controller firmware does not publish the optional 0x4070 d[8] physical
# safety byte. Engineering actuator tests therefore use checksum-valid M-core
# telemetry plus an explicit on-screen operator confirmation. Keep strict mode
# enabled on robots whose firmware provides the full safety byte.
ACTUATOR_DEBUG_REQUIRE_SAFETY_STATUS=false

# Keep the higher-level cleaning runtime alive, but do not require the legacy TCP
# M-core bridge for readiness while the new serial actuator protocol is being
# brought over.
REQUIRE_MCORE_BRIDGE_FOR_READINESS=false
TASK_AUTO_CHARGE_ENABLE=false
EXECUTOR_AUTO_CHARGE_ENABLE=false

# Commercial runtime tuning entry.
# Keep field tuning here so launch files only provide fallback defaults.
STATION_SERVER_IP=10.0.0.12
STATION_SERVER_PORT=5007

# Fine docking stop/success rule:
# stop_threshold = DOCK_TARGET_DIST + DOCK_XY_TOLERANCE.
# Increase these values to stop farther from the charging station; decrease them
# to dock closer.
# Once the stop threshold is reached, the docking controller must stop first;
# DOCK_YAW_TOLERANCE only decides whether that stopped pose is accepted as a
# normal fine-docking success.
DOCK_TARGET_DIST=0.783
DOCK_XY_TOLERANCE=0.003
DOCK_YAW_TOLERANCE=0.04
DOCK_POSE_SCORE_THRESH=0.00012
DOCK_CALIBRATION_STORAGE_PATH=/data/coverage/dock_calibration.yaml

MECHANICAL_CONNECT_ENABLE=false
SKIP_PRECISE_DOCKING_IF_STATION_IN_PLACE=false
DIRECT_CHARGE_AFTER_PRECISE_DOCKING=true
CHARGE_VOLTAGE_CONFIRM_ENABLE=false
DOCK_SUPPLY_ENABLE_DRAIN=false
DOCK_SUPPLY_ENABLE_REFILL=false
DOCK_SUPPLY_DRAIN_TIMEOUT_S=600.0
DOCK_SUPPLY_TARGET_CLEAN_LEVEL=74
DOCK_SUPPLY_REFILL_TIMEOUT_S=600.0
DOCK_SUPPLY_REFILL_SETTLE_S=20.0
DOCK_SUPPLY_COMBINED_STATUS_WAIT_S=5.0
DOCK_SUPPLY_COMBINED_STATUS_STALE_TIMEOUT_S=3.0

AUTO_CHARGE_TARGET_SOC=0.95
AUTO_CHARGE_LOW_SOC=0.15
AUTO_CHARGE_RESUME_SOC=0.95
AUTO_CHARGE_REARM_SOC=0.95
DEFAULT_RETURN_TO_DOCK_ON_FINISH=false

AUTO_CHARGE_MONITOR_ENABLE=false
AUTO_CHARGE_MONITOR_RESET_ON_START=false
AUTO_CHARGE_MONITOR_COUNT_AUTO_ONLY=true
AUTO_CHARGE_MONITOR_RECOVERY_ENABLE=false
AUTO_CHARGE_MONITOR_RECOVERY_STRATEGY=redock
AUTO_CHARGE_MONITOR_RECOVERY_TIMEOUT_S=180.0
AUTO_CHARGE_MONITOR_RECOVERY_MIN_SOC_DELTA=0.001
AUTO_CHARGE_MONITOR_RECOVERY_MAX_ATTEMPTS=2
# Used only by the legacy contact_jog strategy. The redock strategy uses
# dock_supply_manager back_distance/back_speed (currently 2.2m at 0.10m/s).
AUTO_CHARGE_MONITOR_RECOVERY_BACK_DISTANCE_M=0.20
AUTO_CHARGE_MONITOR_RECOVERY_FORWARD_DISTANCE_M=0.205
AUTO_CHARGE_MONITOR_RECOVERY_SPEED_MPS=0.03
AUTO_CHARGE_MONITOR_RECOVERY_TOGGLE_CHARGE=false
AUTO_CHARGE_MONITOR_RECOVERY_REDOCK_SERVICE=/coverage_task_manager/auto_charge_redock
AUTO_CHARGE_MONITOR_RECOVERY_EXHAUSTED_SERVICE=/coverage_task_manager/auto_charge_recovery_exhausted

# Try to reload and localize the active map on boot. With
# ALLOW_NO_ACTIVE_MAP_STARTUP=1 in the systemd unit, a brand-new robot with no
# active map still boots service-ready instead of blocking startup.
STARTUP_RELOCALIZE_ENABLE=true

# The production Site Gateway runs on the same controller and proxies browser
# traffic. Keep rosbridge local unless a reviewed maintenance workflow requires
# direct LAN access.
ROSBRIDGE_ADDRESS=127.0.0.1
